---
import NavLink from "./NavLink.astro";
import Logo from "@assets/logo.svg";

const mobileLink = "place-items-start text-4xl py-3";
---

<header
    class:list={[
        "h-20 grid sticky top-0 z-50",
        "grid-cols-1 px-8 sm:px-20 md:px-0",
        "md:grid-cols-[1fr_var(--content-container-md)_1fr] lg:grid-cols-[1fr_var(--content-container-lg)_1fr]",
        "xl:grid-cols-[1fr_var(--content-container-xl)_1fr] 2xl:grid-cols-[1fr_var(--content-container-2xl)_1fr]",
    ]}
>
    <nav class="peer md:col-start-2 flex justify-between items-center z-50">
        <a href="/" aria-label="return to home page">
            <Logo class="w-16 md:w-18 h-16 md:h-18" aria-label="logo, spells out f-a-v-i, period" />
        </a>
        <div>
            <div class="hidden md:flex justify-evenly items-center space-x-4 md:space-x-8">
                <NavLink href="/stuff">stuff.</NavLink>
                <NavLink href="/contact">contact.</NavLink>
            </div>
        </div>
        <label
            class="md:hidden grid *:col-start-1 *:row-start-1 px-1 text-primary text-4xl cursor-pointer rounded-md has-focus-visible:ring-3"
        >
            <input id="menu" type="checkbox" aria-label="Toggle menu" class="peer sr-only" />
            <i
                aria-hidden="true"
                class="ph-bold ph-list transition-[opacity,rotate] duration-300 peer-checked:opacity-0 peer-checked:rotate-90 motion-reduce:transition-none"
            ></i>
            <i
                aria-hidden="true"
                class="ph-bold ph-x opacity-0 -rotate-90 transition-[opacity,rotate] duration-300 peer-checked:opacity-100 peer-checked:rotate-0 motion-reduce:transition-none"
            ></i>
        </label>
    </nav>

    <nav
        class:list={[
            "nav-links col-span-3 min-h-screen px-4 sm:px-16 pt-28 flex flex-col items-start gap-4 bg-secondary fixed inset-x-0 md:hidden",
            // fade + slight drop in; visibility keeps the closed menu out of tab order and clicks
            "invisible opacity-0 -translate-y-2",
            "peer-has-checked:visible peer-has-checked:opacity-100 peer-has-checked:translate-y-0",
            "transition-[opacity,translate,visibility] duration-300 ease-out motion-reduce:transition-none",
        ]}
    >
        <NavLink href="/#about" class={mobileLink}>about me.</NavLink>
        <NavLink href="/stuff" class={mobileLink}>stuff.</NavLink>
        <NavLink href="/contact" class={mobileLink}>contact.</NavLink>
    </nav>
    <div class="backdrop col-span-full"></div>
</header>

<script>
    let observer: IntersectionObserver | undefined;

    // ClientRouter swaps the header on every navigation, so re-attach to the new one
    document.addEventListener("astro:page-load", () => {
        const menu = document.querySelector<HTMLInputElement>("#menu");

        // close the mobile menu when following a link (e.g. /#about on the same page)
        document.querySelectorAll(".nav-links a").forEach(link =>
            link.addEventListener("click", () => {
                if (menu) menu.checked = false;
            }),
        );

        observer?.disconnect();

        const header = document.querySelector("header");
        if (!header) return;

        observer = new IntersectionObserver(
            ([e]) => e.target.classList.toggle("bg-transparent", e.intersectionRatio < 1),
            { threshold: [1], rootMargin: "4px 0px 0px 0px" },
        );

        observer.observe(header);
    });

    // Escape closes the mobile menu (registered once; the script only runs once)
    document.addEventListener("keydown", e => {
        const menu = document.querySelector<HTMLInputElement>("#menu");
        if (e.key === "Escape" && menu?.checked) {
            menu.checked = false;
            menu.focus();
        }
    });
</script>

<style>
    @supports (backdrop-filter: blur(16px)) or (-webkit-backdrop-filter: blur(16px)) {
        .backdrop {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, var(--color-secondary) 0%, transparent 50%);
            backdrop-filter: blur(16px);
            mask-image: linear-gradient(to bottom, black 0% 50%, transparent 50% 100%);
            pointer-events: none;
        }
    }

    @supports (mask-image: none) {
        .backdrop {
            height: 200%;
            mask-image: linear-gradient(to bottom, black 0% 50%, transparent 50% 100%);
            pointer-events: none;
        }
    }
</style>
