---
import type { MarkdownHeading } from "astro";

import TocHeading from "./TocHeading.astro";

type Props = {
	headings: MarkdownHeading[];
};

export type Heading = MarkdownHeading & {
	subheadings: Heading[];
};

const buildToc = (headings: MarkdownHeading[]) => {
	const toc: Heading[] = [];
	const parentHeadings = new Map<number, Heading>();

	for (const h of headings) {
		if (h.depth === 1) continue;
		const heading: Heading = { ...h, subheadings: [] };

		// a new heading closes any deeper sections that came before it
		for (const depth of [...parentHeadings.keys()]) {
			if (depth >= heading.depth) parentHeadings.delete(depth);
		}

		// attach to the nearest shallower heading, tolerating skipped levels (h2 -> h4)
		let parent: Heading | undefined;
		for (let depth = heading.depth - 1; depth >= 2 && !parent; depth--) {
			parent = parentHeadings.get(depth);
		}

		if (parent) parent.subheadings.push(heading);
		else toc.push(heading);

		parentHeadings.set(heading.depth, heading);
	}

	return toc;
};

const { headings } = Astro.props;
const toc = buildToc(headings);
---

<nav
	id="toc"
	class:list={[
		"not-prose place-self-end self-start col-start-3 contents-center",
		"row-start-1 row-[span_1_/_span_300]",
		"hidden lg:block",
		"sticky top-40", // height of navbar + top container padding
		// a long ToC scrolls on its own instead of running off the bottom of the screen
		"max-h-[calc(100dvh-12rem)] overflow-y-auto overscroll-contain",
		"text-slate-700 rounded-xs scroll-mt-8",
	]}
	aria-label="Table of contents"
>
	<div class="mb-4 text-lg text-primary font-bold font-body tracking-[0.2rem]">CONTENTS</div>
	<ul>
		{toc.map(h => <TocHeading heading={h} />)}
	</ul>
</nav>

<style>
	@media (prefers-reduced-motion: no-preference) {
		#toc {
			animation-name: animateIn;
			animation-duration: 1.4s;
			animation-fill-mode: forwards;
			animation-timing-function: var(--ease-in-cubic);
		}
	}

	@keyframes animateIn {
		0% {
			opacity: 0;
			transform: translateY(30px);
		}

		100% {
			opacity: 1;
			transform: translateY(0px);
		}
	}
</style>

<script>
	// Scroll-spy: the active entry is the last heading scrolled past a line just below the navbar.
	// For a sub-heading, its parent entries are marked too, so the whole section reads as current.
	const ACTIVE_LINE = 160; // px from the top of the viewport

	// bundled script: runs once, so reset per page instead of stacking listeners
	let controller: AbortController | undefined;

	document.addEventListener("astro:page-load", () => {
		controller?.abort();
		controller = undefined;

		const toc = document.querySelector<HTMLElement>("#toc");
		if (!toc) return;

		const entries = [...toc.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]")].flatMap(link => {
			const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
			return heading ? [{ link, heading }] : [];
		});
		if (entries.length === 0) return;

		controller = new AbortController();
		const { signal } = controller;

		const update = () => {
			const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;

			let active = atBottom ? entries.at(-1) : undefined;
			if (!active) {
				for (const entry of entries) {
					if (entry.heading.getBoundingClientRect().top > ACTIVE_LINE) break;
					active = entry;
				}
			}

			for (const { link } of entries) {
				link.removeAttribute("aria-current");
				delete link.dataset.ancestor;
			}
			if (!active) return;

			active.link.setAttribute("aria-current", "location");
			for (let li = active.link.closest("li")?.parentElement?.closest("li"); li; li = li.parentElement?.closest("li")) {
				const parentLink = li.querySelector<HTMLAnchorElement>(":scope > a[data-toc-link]");
				if (parentLink) parentLink.dataset.ancestor = "";
			}

			// on short screens the ToC scrolls itself; keep the active entry in view
			// (adjusting scrollTop directly, since scrollIntoView would also scroll the page)
			if (toc.scrollHeight > toc.clientHeight) {
				const linkBox = active.link.getBoundingClientRect();
				const tocBox = toc.getBoundingClientRect();
				if (linkBox.top < tocBox.top) toc.scrollTop -= tocBox.top - linkBox.top + 8;
				else if (linkBox.bottom > tocBox.bottom) toc.scrollTop += linkBox.bottom - tocBox.bottom + 8;
			}
		};

		let frame = 0;
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(() => ((frame = 0), update()));
		};
		addEventListener("scroll", schedule, { passive: true, signal });
		addEventListener("resize", schedule, { passive: true, signal });
		update();

		// smooth-scroll to the clicked heading (instant with reduced motion)
		toc.addEventListener(
			"click",
			e => {
				const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-toc-link]");
				const target = link && document.getElementById(decodeURIComponent(link.hash.slice(1)));
				if (!link || !target) return;

				e.preventDefault();
				const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
				target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
				history.replaceState(history.state, "", link.hash);
			},
			{ signal },
		);
	});
</script>
