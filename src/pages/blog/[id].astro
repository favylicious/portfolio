---
import { render } from "astro:content";

import Related from "@content/components/Related.astro";
import Tags from "@content/components/Tags.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
import { getEntries } from "astro:content";
import { DateTime } from "luxon";
import { getBlogPosts } from "../../content.config";

export async function getStaticPaths() {
    const posts = await getBlogPosts();
    return posts.map(post => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const tags = await getEntries(post.data.tags);
const {
    Content,
    headings,
    remarkPluginFrontmatter: frontmatter,
} = await render(post);

const lastUpdated = DateTime.fromISO(frontmatter.lastUpdated)
    .setZone("Asia/Singapore")
    .toLocaleString(DateTime.DATE_FULL);
const { title, description, draft, pubDate, related } = post.data;
---

<ContentLayout title={title} headings={headings} tags={tags}>
    <h1>{title}</h1>
    <div class="mb-6 font-display font-medium text-gray-600">
        Published {
            DateTime.fromJSDate(pubDate)
                .setZone("Asia/Singapore")
                .toLocaleString(DateTime.DATE_FULL)
        } : updated {lastUpdated}
    </div>
    <Tags data={tags} />
    <Content />
    <Related slot="related" related={related} />
</ContentLayout>
