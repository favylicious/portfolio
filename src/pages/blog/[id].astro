---
import { render } from "astro:content";

import { mdxComponents } from "@content/components/mdx";
import Related from "@content/components/Related.astro";
import Tags from "@content/components/Tags.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
import { getEntries } from "astro:content";
import { formatLongDate, parseDate } from "@util/date";
import { getBlogPosts } from "../../content.config";

export async function getStaticPaths() {
    const posts = await getBlogPosts();
    return posts.map(post => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const tags = await getEntries(post.data.tags);
const {
    Content,
    headings,
    remarkPluginFrontmatter: frontmatter,
} = await render(post);

const lastUpdated = formatLongDate(parseDate(frontmatter.lastUpdated));
const { title, description, draft, pubDate, related } = post.data;
---

<ContentLayout title={title} headings={headings} tags={tags}>
    <h1>{title}</h1>
    <div class="mb-6 font-display font-medium text-gray-600">
        Published {formatLongDate(pubDate)} : updated {lastUpdated}
    </div>
    <Tags data={tags} />
    <Content components={mdxComponents} />
    <Related slot="related" related={related} />
</ContentLayout>
